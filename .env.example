# Copy this file to .env and fill your own values. Never commit .env
# (REAL values kabhi repo me mat daalo — GitHub secret-scan block karta hai)
KARTOONS_EMAIL=PUT-YOUR-KARTOONS-USERNAME
KARTOONS_PASSWORD=PUT-YOUR-KARTOONS-PASSWORD
# Gemini vision fallback (search-result + season/episode select me AI help).
# Key: https://aistudio.google.com/app/apikey se free me banao.
GEMINI_API_KEY=PUT-YOUR-GEMINI-KEY
AI_VISION=1
# AUTO_FIND=1: (Season, Ep) site par na mile to overall episode number maan ke
# sahi Season/Episode khud dhoondta hai. 0 = sirf batayega, khud nahi badhega.
AUTO_FIND=1

# UNATTENDED=1 karo to script kabhi input() par nahi atkegi.
# Galat season/ep likh ke chale jaoge to 5 min baad html_dumps/ +
# screenshot chhod ke clean exit karegi (galat download NAHI hogi).
UNATTENDED=1
# Har page ke baad HTML save karna hai? (html_dumps/ folder me)
HTML_DUMP=1
# Manual wait kitne sec baad auto-fail ho (unattended me): default 300 = 5 min
MANUAL_WAIT_SECS=300

# ---- Telegram bot (Phase 1) ----
# BotFather se banao: /newbot -> token yahan
BOT_TOKEN=PUT-YOUR-BOT-TOKEN
# Sirf tumhare chat IDs (comma-separated) — baaki koi ignore hoga
ALLOWED_CHAT_IDS=7008609963
# Normal Bot API = 50MB video limit.
# FULL VIDEO (2GB) chahiye to entrypoint.sh Local Bot API server chalata hai —
# uske liye  + API_HASH secrets daalo aur ye karo:
#   BOT_API_URL=http://localhost:8081
BOT_API_URL=https://api.telegram.org
# Local Bot API (2GB limit) ke liye — https://my.telegram.org -> API development tools
# (ye secrets/vars HF Space ya .env me alag se daalne hain; khaali = 50MB wala normal API)
API_ID=PUT-YOUR-API-ID
API_HASH=PUT-YOUR-API-HASH
# Video send ke baad file delete? Render=1 (disk bachao), local test me 0 rakh sakte ho
DELETE_AFTER_SEND=1
